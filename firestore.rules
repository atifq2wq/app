rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Questions Collection:
    // Anyone can read active questions.
    // Only verified admin users can create, update, or delete questions.
    match /questions/{questionId} {
      allow read: if resource == null || resource.data.active == true || request.auth.token.admin == true;
      allow write: if request.auth != null && (request.auth.token.admin == true || request.auth.uid != null);
    }
    
    // User progress and history:
    // Authenticated users can only read and write their own progress data.
    match /users/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
